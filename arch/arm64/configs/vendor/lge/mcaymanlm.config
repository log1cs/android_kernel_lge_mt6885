# Platform
CONFIG_ARCH_MTK_PROJECT="muse6883_caymanlm_s"
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES="mediatek/mt6885"
CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE_NAMES="mediatek/muse6883_caymanlm_s"
CONFIG_CMDLINE="console=tty0 console=ttyMT3,921600n1 root=/dev/ram vmalloc=496M slub_max_order=0 slub_debug=O"
CONFIG_MACH_MT6885=y
CONFIG_MACH_MT6885_CAYMAN=y

# Display
CONFIG_CAYMAN_HDMI=y
CONFIG_DRM_PANEL_BOE_SW43103_CMD=y
CONFIG_LCM_HEIGHT="2460"
CONFIG_LCM_WIDTH="1080"
CONFIG_LEDS_MTK_DISP=y
CONFIG_LGE_DISPLAY_COMMON=y
CONFIG_LGE_DISPLAY_RECOVERY=y
CONFIG_LGE_DISPLAY_REFRESH_RATE_DIV=y
CONFIG_LGE_DISPLAY_TUNING_SUPPORT=y
CONFIG_MTK_HDMI_SUPPORT=y
# CONFIG_LEDS_MTK_PWM is not set

# Touchscreen
CONFIG_LGE_TOUCH_APP_FW_UPGRADE=y
CONFIG_LGE_TOUCH_CORE=y
CONFIG_LGE_TOUCH_CORE_MTK=y
CONFIG_LGE_TOUCH_DEX=y
CONFIG_LGE_TOUCH_FW_PATH="touch/mcaymanlm"
CONFIG_LGE_TOUCH_LGSIC_SW42902=y
CONFIG_LGE_TOUCH_PEN=y
CONFIG_LGE_TOUCH_USE_PANEL_NOTIFY=y

# Fingerprint
CONFIG_FINGERPRINT_EGISTEC_FOD=y
CONFIG_MTK_FINGERPRINT_SUPPORT=y

# Audio
CONFIG_LGE_ACCDET=y
CONFIG_SND_SOC_TFA9878=y

# Haptics
CONFIG_TSPDRV=y
CONFIG_VIB_DW7800=y

# Camera
CONFIG_CUSTOM_KERNEL_CAM_CAL_DRV="BRCB032GWZ_3 GT24c32a cat24c16"
CONFIG_CUSTOM_KERNEL_IMGSENSOR="s5kgm2_mipi_raw hi1634_mipi_raw sl556_mipi_raw sl846_mipi_raw"
CONFIG_MTK_LENS_DW9800VAF_SUPPORT=y
CONFIG_MTK_LENS_GT9772AF_SUPPORT=y

# Sensors
CONFIG_INPUT_SAR_ALMF04QFN_2_3CH_NIT=y
CONFIG_LGE_HALLIC_SUPPORT=y
CONFIG_LGE_SAR_CONTROLLER_USB_DETECT=y
CONFIG_LGE_USE_SAR_CONTROLLER=y
# CONFIG_CUSTOM_KERNEL_GMRV_SENSOR is not set
# CONFIG_CUSTOM_KERNEL_GRAVITY_SENSOR is not set
# CONFIG_CUSTOM_KERNEL_GRV_SENSOR is not set
# CONFIG_CUSTOM_KERNEL_LINEARACCEL_SENSOR is not set
# CONFIG_CUSTOM_KERNEL_RV_SENSOR is not set
# CONFIG_CUSTOM_KERNEL_UNCALI_ACC_SENSOR is not set
# CONFIG_CUSTOM_KERNEL_UNCALI_GYRO_SENSOR is not set
# CONFIG_CUSTOM_KERNEL_UNCALI_MAG_SENSOR is not set
# CONFIG_MTK_GLGHUB is not set
# CONFIG_MTK_MOTION_DETECT_HUB is not set
# CONFIG_MTK_PICKUPHUB is not set
# CONFIG_MTK_STATHUB is not set
# CONFIG_MTK_TILTDETECTHUB is not set
# CONFIG_MTK_WAKEHUB is not set

# NFC
CONFIG_LGE_NFC=y
CONFIG_LGE_NFC_PN553=y

# Power
CONFIG_CHARGER_BQ25970=y
CONFIG_CHARGER_MAX77932=y
# CONFIG_CHARGER_RT9465 is not set
# CONFIG_CHARGER_RT9759 is not set
CONFIG_LGE_PM=y
CONFIG_LGE_PM_BATTERY_AGING_FACTOR=y
CONFIG_LGE_PM_BATTERY_CYCLE=y
CONFIG_LGE_PM_BATTERY_ID=y
CONFIG_LGE_PM_BATTERY_NTC_TUNED=y
CONFIG_LGE_PM_CHARGER_CONTROLLER=y
CONFIG_LGE_PM_CHARGERLOGO=y
CONFIG_LGE_PM_DEBUG=y
CONFIG_LGE_PM_GPU_UTILITY=y
CONFIG_LGE_PM_POWER_SYSFS=y
CONFIG_LGE_PM_PRM=y
CONFIG_LGE_PM_PSEUDO_BATTERY=y
CONFIG_LGE_PM_PSEUDO_HVDCP=y
CONFIG_LGE_PM_TMR=y
CONFIG_LGE_PM_USB_ID=y
CONFIG_LGE_PM_VTS=y
CONFIG_LGE_PM_WIRELESS_CHARGER=y
CONFIG_LGE_UFS_PWR_MODE_CHANGE=y
CONFIG_MTK_PUMP_EXPRESS_50_SUPPORT=y
CONFIG_MTK_PUMP_EXPRESS_PLUS_20_SUPPORT=y
CONFIG_WIRELESS_CHARGER_RX_P9222=y

# USB
CONFIG_DUAL_ROLE_USB_INTF=y
CONFIG_LGE_DUAL_SCREEN=y
CONFIG_LGE_USB=y
CONFIG_LGE_USB_GADGET=y
CONFIG_LGE_USB_LATTICE_SLS11HC=y
CONFIG_LGE_USB_MOISTURE_DETECTION=y
CONFIG_LGE_USB_MOISTURE_FUSB251=y
CONFIG_LGE_USB_SBU_SWITCH=y
CONFIG_LGE_USB_TUSB546=y
CONFIG_LGE_USB_TYPE_C=y
# CONFIG_LGE_DUAL_SCREEN_DISABLE is not set

# Misc
CONFIG_LGE_BOOT_MODE=y
CONFIG_LGE_EARJACK_DEBUGGER=y
CONFIG_LGE_HANDLE_PANIC=y
CONFIG_MTK_PERFMGR_TOUCH_BOOST=y
CONFIG_MTK_SIM_LOCK_POWER_ON_WRITE_PROTECT=y
CONFIG_MTK_TC1_FEATURE=y
